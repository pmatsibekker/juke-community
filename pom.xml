<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>io.github.pmatsibekker</groupId>
	<artifactId>juke-test-harness</artifactId>
	<version>1.0.0</version>
	<packaging>pom</packaging>

	<name>Juke Test Harness</name>
	<description>Juke — a record-and-replay testing framework for Spring Boot that captures real upstream interactions and replays them deterministically.</description>
	<url>https://github.com/pmatsibekker/juke-community</url>
	<inceptionYear>2026</inceptionYear>

	<licenses>
		<license>
			<name>The Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>pmatsibekker</id>
			<name>Pavel Matsibekker</name>
			<email>pmatsibekker@gmail.com</email>
			<url>https://github.com/pmatsibekker</url>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:https://github.com/pmatsibekker/juke-community.git</connection>
		<developerConnection>scm:git:ssh://git@github.com/pmatsibekker/juke-community.git</developerConnection>
		<url>https://github.com/pmatsibekker/juke-community</url>
		<tag>HEAD</tag>
	</scm>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>25</maven.compiler.release>
		<jacoco.version>0.8.14</jacoco.version>
		<spring.boot.version>3.5.0</spring.boot.version>
	</properties>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.13.0</version>
					<configuration>
						<release>25</release>
						<!-- Emit method parameter names. spring-boot-starter-parent
						     set this; the reparented Spring Boot modules (remix,
						     coverage) need it so Spring MVC can resolve @PathVariable
						     / @RequestParam argument names by reflection. -->
						<parameters>true</parameters>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>3.5.3</version>
				</plugin>
				<!-- Pinned so the reparented remix module can declare
				     spring-boot-maven-plugin without an inherited version. -->
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
					<version>${spring.boot.version}</version>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<profiles>
		<!-- Activated with -Prelease for Maven Central publishing. A plain
		     `mvn install` is unaffected: no signing, no Javadoc/source jars,
		     no contact with the Central Portal. -->
		<profile>
			<id>release</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-source-plugin</artifactId>
						<version>3.3.1</version>
						<executions>
							<execution>
								<id>attach-sources</id>
								<goals>
									<goal>jar-no-fork</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-javadoc-plugin</artifactId>
						<version>3.11.2</version>
						<configuration>
							<doclint>none</doclint>
							<quiet>true</quiet>
							<failOnError>false</failOnError>
						</configuration>
						<executions>
							<execution>
								<id>attach-javadoc</id>
								<goals>
									<goal>jar</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>3.2.7</version>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
								<configuration>
									<!-- Loopback so signing never blocks on an
									     interactive pinentry dialog. -->
									<gpgArguments>
										<arg>--pinentry-mode</arg>
										<arg>loopback</arg>
									</gpgArguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<version>0.8.0</version>
						<extensions>true</extensions>
						<configuration>
							<publishingServerId>central</publishingServerId>
							<!-- Upload + validate only; click "Publish" in the
							     Central Portal UI to release. Set to true once
							     you trust the pipeline. -->
							<autoPublish>false</autoPublish>
							<deploymentName>juke ${project.version}</deploymentName>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<modules>
		<module>juke-plugin-api</module>
		<module>juke-plugin-sdk</module>
		<module>juke-framework</module>
		<module>juke-remix-rest-service</module>
		<module>juke-coverage</module>
		<module>juke-samples</module>
	</modules>
</project>
